default namespace p = "http://www.w3.org/ns/xproc"
namespace local = ""

# This schema could be made more constrained.

Step = Step-dfdl-parse

Step-dfdl-parse =
  element dfdl-parse {
    name.ncname.attr?,
    common.attributes,
    use-when.attr?,
    step.attributes,
    attribute fail-on-error { avt.datatype }?,
    attribute infoset { avt.datatype }?,
    attribute parameters { avt.datatype }?,
    attribute root { avt.datatype }?,
    attribute stream { avt.datatype }?,
    (WithInput* & WithOption* & (Documentation|PipeInfo)*)
  }

